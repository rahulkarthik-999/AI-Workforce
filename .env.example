# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string. REQUIRED in production (e.g. Neon via the Vercel Marketplace).
# Leave empty locally to use the embedded development database (stored in .data/).
DATABASE_URL=

# --- AI provider (at least one key is required to run goals) --------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional: force a provider when several keys are present (anthropic | openai | deepseek).
AI_PROVIDER=
# Optional: override models. Defaults: anthropic claude-opus-5-5, openai gpt-4.1 / gpt-4.1-mini, deepseek deepseek-chat.
AI_MODEL=
AI_FAST_MODEL=
# Optional: OpenAI-compatible endpoint (proxy / gateway).
OPENAI_BASE_URL=
# Optional: per-model prices in USD per 1M tokens, e.g. {"my-model":{"input":1,"output":4}}
AI_PRICING_JSON=

# --- App ------------------------------------------------------------------------
# Public base URL of this deployment (used for engine self-invocation). On Vercel, VERCEL_URL is used if unset.
APP_URL=
# Secret for the engine's internal continuation endpoint. Recommended in production (any long random string).
ENGINE_SECRET=
# Secret Vercel Cron sends as "Authorization: Bearer ..." to /api/cron/sweep.
CRON_SECRET=
# Set to false to close signups after the first account is created.
ALLOW_SIGNUPS=true

# --- Tools (each is optional; unconfigured tools are reported as unavailable) ---
# Web search (https://tavily.com)
TAVILY_API_KEY=
# Email sending (https://resend.com). EMAIL_FROM must be a verified sender, e.g. "Acme <hello@acme.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Image generation uses OPENAI_API_KEY. Optional model override (default gpt-image-1).
OPENAI_IMAGE_MODEL=

# --- Limits and cost control (defaults shown) -----------------------------------
GOAL_BUDGET_USD=2
MAX_TASKS_PER_GOAL=16
MAX_TASK_RETRIES=2
MAX_AGENT_ITERATIONS=12
MAX_REPLANS_PER_GOAL=2
MAX_PARALLEL_TASKS=3
TASK_TIMEOUT_MS=170000
GOALS_PER_HOUR=20
